/modules/

# HOST 세션상태 (런타임, 머신별)
host_state_*.json
guard_zones_local.json
# FFTW wisdom 캐시 (머신별 런타임 산출물 — 첫 실행 시 자동 생성)
fftw_wisdom.f
# BEAE AI 모듈 (venv 6.9GB torch — 코드만 추적)
BEAE/ais/.venv/
BEAE/ais/**/__pycache__/
# data/ 는 ai_history(차트/CSV) 만 추적. aicap(raw IQ, 매일 수십MB 누적)·ai.sock·
# ai_status.json(런타임 상태)·ai_daemon.log 는 계속 제외.
BEAE/ais/data/aicap_*.bin
BEAE/ais/data/ai.sock
BEAE/ais/data/ai_status.json
BEAE/ais/data/ai_daemon.log
# 논문용 차트는 제외 (584KB, 로컬 산출물). 운용용 training_trend.png 는 계속 추적.
BEAE/ais/data/ai_history/charts/training_trend_paper.png
# 모델 스냅샷 — 학습마다 2.5MB .pt 가 새로 쌓여 리포가 비대해짐. 머신 로컬에만 둔다.
BEAE/ais/data/ai_model/
# few-shot 프로토타입 모듈 — 아직 실험 단계라 스냅샷·로그 전부 제외 (리포엔 코드만)
BEAE/ais/data/ai_model_proto/
# GUARD 런타임 출력 — 일자별 alert JSONL(실선박 MMSI·좌표)·데몬 로그. 공개 리포라 추적 금지.
BEAE/ais/data/guard/
# BEAE AMC (자동변조인식) — AIS 와 동일 정책: 코드만 추적, 데이터/모델 로컬 전용
BEAE/amc/.venv/
BEAE/amc/**/__pycache__/
BEAE/amc/data/
# BEAE UAV (ExpressLRS 2.4GHz 역산/해독) — 코드만 추적, venv/IQ녹음 로컬 전용
BEAE/uav/.venv/
BEAE/uav/**/__pycache__/
BEAE/uav/data/
