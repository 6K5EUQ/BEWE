# Build directories
build/
central/build/
build_cli/

# Claude Code project instructions (machine-local, not shared via git)
CLAUDE.md

# Per-HOST configuration (seeded with defaults on first run; edits accumulate locally)
band_plan.json
band_categories.json

# Recordings / IQ data
recordings/

# Download cache (multi-GB, machine-local)
downloads/

# Central server runtime archive (machine-local on Central host)
DataBase/

# Auto-fetched TLE catalogs (regenerated from celestrak.org on startup).
# SOI_tle.txt is operator-defined and IS tracked.
assets/tle/starlink_tle.txt
assets/tle/etc_tle.txt
assets/tle/SOT_tle.txt
assets/tle/leo_tle.txt

# Mission persistence (machine-local state)
missions.json
.last_rolled

# Raw capture / sidecar files (never commit)
*.bewehist
*.bewewf
*.info

# IDE / editor
*.swp
*.swo
*~
.vscode/
.idea/
*.kate-swp

# ImGui layout (user-specific)
imgui.ini
**/imgui.ini

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# Compiled binaries
BEWE
bewe_central
*.o
*.a
*.so
*.so.*

# Credentials / secrets
*.key
*.pem
*.crt
*.env
.env*
credentials*
secrets*

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# 런타임 모듈 데이터 아카이브 (acars/wifi JSONL + IQ 덤프)
/modules/

# HOST 세션상태 (런타임, 머신별)
host_state_*.json
# BEAE AI 모듈 (venv 6.9GB torch — 코드만 추적)
BEAE/ais/.venv/
BEAE/ais/**/__pycache__/
# data/ 는 ai_model(스냅샷)·ai_history(차트/CSV) 만 추적. aicap(raw IQ, 매일 수십MB
# 누적)·ai.sock·ai_status.json(런타임 상태)·ai_daemon.log 는 계속 제외.
BEAE/ais/data/aicap_*.bin
BEAE/ais/data/ai.sock
BEAE/ais/data/ai_status.json
BEAE/ais/data/ai_daemon.log
# BEAE STT POC (venv + 러닝로그 — 코드만 추적)
BEAE/stt/.venv/
BEAE/stt/**/__pycache__/
BEAE/stt/*.log
